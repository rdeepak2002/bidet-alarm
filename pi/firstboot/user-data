#cloud-config
hostname: bidet-alarm
manage_etc_hosts: true
timezone: America/Los_Angeles
keyboard:
  model: pc105
  layout: us
users:
  - name: pi
    groups: users,adm,dialout,audio,netdev,video,plugdev,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - SSH_PUBLIC_KEY        # filled in by prepare_sd_card.sh from ~/.ssh/id_ed25519.pub
enable_ssh: true
ssh_pwauth: false
runcmd:
  - [raspi-config, nonint, do_wifi_country, US]
  - [rfkill, unblock, wifi]
  - [systemctl, enable, --now, ssh]
